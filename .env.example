# ==============================================================================
# FRAUDLENS AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=FraudLens AI
APP_VERSION=1.0.0

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration
# Defaults to local SQLite for instant zero-dependency execution.
# For production PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/fraudlens
DATABASE_URL=sqlite+aiosqlite:///./fraudlens.db

# Machine Learning Model Configuration
MODEL_DIR=./models
ACTIVE_MODEL_VERSION=v1.0.0
ENABLE_SHAP_EXPLAINABILITY=true

# Optional LLM Configuration for AI Cybersecurity Assistant & Explanation Agent
# Supported providers: "openai", "anthropic", "groq", "ollama", "mock"
# Note: Core ML scanner works 100% deterministically without an LLM key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Optional Threat Intelligence API Keys
# Core scanner works with URL ML + DNS heuristics if external feeds are not provided.
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=

# Security & Network Controls
ENABLE_LIVE_SSRF_PROTECTED_DNS=true
DNS_TIMEOUT_SECONDS=3.0
MAX_REDIRECTS_ALLOWED=5
SCAN_RETENTION_DAYS=90

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:8000
